PORT=8080
# Orígenes CORS habilitados, separados por coma (obligatorio, el arranque falla si falta)
ORIGIN_URL=https://your-frontend.example.com

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notifications
REDIS_HOST=localhost
REDIS_PORT=6379
# Contraseña de Redis (vacía si no requiere AUTH; obligatoria en producción)
REDIS_PASS=
API_KEY=dev-api-key
JWT_SECRET=change-me
DEFAULT_LANGUAGE=es
# Zona horaria para interpretar días locales (filtro date del listado)
TIMEZONE=America/Bogota
MAX_RETRY_ATTEMPTS=3
RATE_LIMIT_PER_MINUTE=100
SECRETS_MASTER_KEY=change-me-64-hex-chars
# WhatsApp Cloud API (fallback legacy; prefer provider config in DB)
WHATSAPP_VERIFY_TOKEN=dev-whatsapp-verify-token
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
